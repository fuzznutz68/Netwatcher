<Window x:Class="NetWatch.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="NetWatch Desktop — Domain Intelligence"
        Height="750" Width="720"
        MinHeight="600" MinWidth="700"
        Background="#0A0E17"
        WindowStartupLocation="CenterScreen"
        ResizeMode="CanResize"
        FontFamily="Consolas">

    <Window.Resources>
        <!-- Terminal color palette -->
        <SolidColorBrush x:Key="BgDeep"      Color="#0A0E17"/>
        <SolidColorBrush x:Key="BgCard"      Color="#0D1117"/>
        <SolidColorBrush x:Key="BgCardHover" Color="#161B22"/>
        <SolidColorBrush x:Key="AccentCyan"  Color="#00E5FF"/>
        <SolidColorBrush x:Key="AccentDim"   Color="#00838F"/>
        <SolidColorBrush x:Key="TextPrimary" Color="#E0E8F0"/>
        <SolidColorBrush x:Key="TextMuted"   Color="#546E7A"/>
        <SolidColorBrush x:Key="TextDim"     Color="#90A4AE"/>
        <SolidColorBrush x:Key="SuccessGreen" Color="#4CAF50"/>
        <SolidColorBrush x:Key="ErrorRed"    Color="#EF5350"/>
        <SolidColorBrush x:Key="WarningAmber" Color="#FFC107"/>

        <Style x:Key="TabBtn" TargetType="Button">
            <Setter Property="Background"  Value="#0D1117"/>
            <Setter Property="Foreground"  Value="#546E7A"/>
            <Setter Property="BorderThickness" Value="0,0,0,2"/>
            <Setter Property="BorderBrush" Value="Transparent"/>
            <Setter Property="FontSize"    Value="12"/>
            <Setter Property="FontWeight"  Value="Medium"/>
            <Setter Property="Padding"     Value="8,10"/>
            <Setter Property="Cursor"      Value="Hand"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border Background="{TemplateBinding Background}"
                                BorderBrush="{TemplateBinding BorderBrush}"
                                BorderThickness="{TemplateBinding BorderThickness}"
                                Padding="{TemplateBinding Padding}">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Border>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
            <Style.Triggers>
                <Trigger Property="IsMouseOver" Value="True">
                    <Setter Property="Foreground" Value="#90A4AE"/>
                </Trigger>
                <Trigger Property="IsPressed" Value="True">
                    <Setter Property="Background" Value="#161B22"/>
                </Trigger>
            </Style.Triggers>
        </Style>

        <Style x:Key="TabBtnActive" TargetType="Button" BasedOn="{StaticResource TabBtn}">
            <Setter Property="Foreground"  Value="#00E5FF"/>
            <Setter Property="BorderBrush" Value="#00E5FF"/>
        </Style>

        <Style x:Key="CardPanel" TargetType="Border">
            <Setter Property="Background" Value="#0D1117"/>
            <Setter Property="CornerRadius" Value="6"/>
            <Setter Property="Padding" Value="12,10"/>
            <Setter Property="Margin" Value="0,4"/>
        </Style>

        <Style x:Key="ActionBtn" TargetType="Button">
            <Setter Property="Background"    Value="#00E5FF"/>
            <Setter Property="Foreground"    Value="#0A0E17"/>
            <Setter Property="FontSize"      Value="13"/>
            <Setter Property="FontWeight"    Value="Bold"/>
            <Setter Property="Padding"       Value="20,10"/>
            <Setter Property="Cursor"        Value="Hand"/>
            <Setter Property="BorderThickness" Value="0"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border Background="{TemplateBinding Background}"
                                CornerRadius="4"
                                Padding="{TemplateBinding Padding}">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Border>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
            <Style.Triggers>
                <Trigger Property="IsEnabled" Value="False">
                    <Setter Property="Background" Value="#00838F"/>
                    <Setter Property="Foreground" Value="#0A0E17"/>
                </Trigger>
                <Trigger Property="IsMouseOver" Value="True">
                    <Setter Property="Background" Value="#4DFFFF"/>
                </Trigger>
            </Style.Triggers>
        </Style>

        <Style x:Key="DangerBtn" TargetType="Button" BasedOn="{StaticResource ActionBtn}">
            <Setter Property="Background" Value="#EF5350"/>
            <Style.Triggers>
                <Trigger Property="IsMouseOver" Value="True">
                    <Setter Property="Background" Value="#FF8A80"/>
                </Trigger>
                <Trigger Property="IsEnabled" Value="False">
                    <Setter Property="Background" Value="#5D4037"/>
                </Trigger>
            </Style.Triggers>
        </Style>

        <Style x:Key="InputBox" TargetType="TextBox">
            <Setter Property="Background"    Value="#0D1117"/>
            <Setter Property="Foreground"   Value="#E0E8F0"/>
            <Setter Property="CaretBrush"    Value="#00E5FF"/>
            <Setter Property="BorderBrush"  Value="#1E2A3A"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="FontSize"    Value="14"/>
            <Setter Property="Padding"      Value="10,8"/>
            <Setter Property="FontFamily"  Value="Consolas"/>
        </Style>

        <Style x:Key="ResultText" TargetType="TextBlock">
            <Setter Property="Foreground" Value="#E0E8F0"/>
            <Setter Property="FontSize"   Value="12"/>
            <Setter Property="FontFamily" Value="Consolas"/>
            <Setter Property="TextWrapping" Value="Wrap"/>
        </Style>

        <Style x:Key="CardTitle" TargetType="TextBlock">
            <Setter Property="Foreground" Value="#00E5FF"/>
            <Setter Property="FontSize"   Value="11"/>
            <Setter Property="FontWeight" Value="Bold"/>
            <Setter Property="Margin"      Value="0,0,0,4"/>
            <Setter Property="FontFamily" Value="Consolas"/>
        </Style>

        <Style x:Key="ScrollViewerStyle" TargetType="ScrollViewer">
            <Setter Property="Background" Value="#0A0E17"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="ScrollViewer">
                        <Border Background="{TemplateBinding Background}">
                            <Grid>
                                <ScrollContentPresenter/>
                                <ScrollBar Name="PART_VerticalScrollBar"
                                           HorizontalAlignment="Right"
                                           Width="6"
                                           Background="Transparent"
                                           Minimum="0"
                                           Maximum="{TemplateBinding ScrollableHeight}"
                                           Value="{TemplateBinding VerticalOffset}"
                                           ViewportSize="{TemplateBinding ViewportHeight}"
                                           Visibility="{TemplateBinding ComputedVerticalScrollBarVisibility}">
                                    <ScrollBar.Template>
                                        <ControlTemplate TargetType="ScrollBar">
                                            <Border Background="Transparent">
                                                <Track Name="PART_Track" IsDirectionReversed="True">
                                                    <Track.Thumb>
                                                        <Thumb Background="#1E2A3A" BorderThickness="0"/>
                                                    </Track.Thumb>
                                                </Track>
                                            </Border>
                                        </ControlTemplate>
                                    </ScrollBar.Template>
                                </ScrollBar>
                            </Grid>
                        </Border>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
    </Window.Resources>

    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
        </Grid.RowDefinitions>

        <!-- Header -->
        <Border Grid.Row="0" Background="#0D1117" Padding="16,12">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>
                <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                    <TextBlock Text="◈ NetWatch" FontSize="18" FontWeight="Bold"
                               Foreground="#00E5FF" FontFamily="Consolas"/>
                    <TextBlock Text=" Desktop" FontSize="18" FontWeight="Bold"
                               Foreground="#546E7A" FontFamily="Consolas"/>
                </StackPanel>
                <TextBlock Grid.Column="1" x:Name="VersionLabel"
                           Foreground="#546E7A" FontSize="11"
                           VerticalAlignment="Center" FontFamily="Consolas"/>
            </Grid>
        </Border>

        <!-- Tab Content -->
        <Grid Grid.Row="1">
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="*"/>
            </Grid.RowDefinitions>

            <!-- Tab Bar -->
            <Border Grid.Row="0" Background="#0D1117">
                <StackPanel Orientation="Horizontal">
                    <Button x:Name="TabDomainBtn"  Content="🌐 DOMAIN INTEL"   Style="{StaticResource TabBtnActive}" Width="170" Click="TabDomain_Click"/>
                    <Button x:Name="TabCheckerBtn" Content="✅ DOMAIN CHECKER" Style="{StaticResource TabBtn}"        Width="170" Click="TabChecker_Click"/>
                    <Button x:Name="TabMyInfoBtn"   Content="📡 MY INFO"        Style="{StaticResource TabBtn}"        Width="150" Click="TabMyInfo_Click"/>
                    <Button x:Name="TabToolsBtn"    Content="🛠 NETWORK TOOLS"  Style="{StaticResource TabBtn}"        Width="160" Click="TabTools_Click"/>
                </StackPanel>
            </Border>

            <!-- Pages -->
            <ScrollViewer Grid.Row="1" Style="{StaticResource ScrollViewerStyle}" VerticalScrollBarVisibility="Auto">
              <Grid>

                <!-- ════════════ DOMAIN INTEL PAGE ════════════ -->
                <StackPanel x:Name="PageDomain" Margin="16,12">
                    <TextBlock Text="Domain Intelligence" Foreground="#00E5FF" FontSize="16" FontWeight="Bold" Margin="0,0,0,8" FontFamily="Consolas"/>
                    <TextBlock Text="Enter a domain to discover subdomains, IPs, CDN, and shared hosts." Foreground="#546E7A" FontSize="11" Margin="0,0,0,12" FontFamily="Consolas" TextWrapping="Wrap"/>

                    <StackPanel Orientation="Horizontal" Margin="0,0,0,8">
                        <TextBox x:Name="DomainInput" Style="{StaticResource InputBox}" Width="340" KeyDown="DomainInput_KeyDown"/>
                        <Button Content="SCAN" Style="{StaticResource ActionBtn}" Margin="8,0,0,0" Click="ScanDomain_Click"/>
                    </StackPanel>

                    <TextBlock x:Name="DomainStatus" Foreground="#546E7A" FontSize="11" Margin="0,4,0,8" FontFamily="Consolas" TextWrapping="Wrap"/>

                    <StackPanel x:Name="DomainResults" />
                </StackPanel>

                <!-- ════════════ DOMAIN CHECKER PAGE ════════════ -->
                <StackPanel x:Name="PageChecker" Margin="16,12" Visibility="Collapsed">
                    <TextBlock Text="Domain Checker" Foreground="#00E5FF" FontSize="16" FontWeight="Bold" Margin="0,0,0,8" FontFamily="Consolas"/>
                    <TextBlock Text="Verify connectivity to well-known service domains." Foreground="#546E7A" FontSize="11" Margin="0,0,0,12" FontFamily="Consolas"/>

                    <StackPanel Orientation="Horizontal" Margin="0,0,0,8">
                        <TextBox x:Name="CustomCheckInput" Style="{StaticResource InputBox}" Width="340" KeyDown="CustomCheck_KeyDown"/>
                        <Button Content="CHECK" Style="{StaticResource ActionBtn}" Margin="8,0,0,0" Click="CustomCheck_Click"/>
                    </StackPanel>

                    <Button Content="Run All Checks" Style="{StaticResource ActionBtn}" HorizontalAlignment="Left" Margin="0,0,0,12" Click="RunAllChecks_Click"/>

                    <StackPanel x:Name="CheckerResults" />
                </StackPanel>

                <!-- ════════════ MY INFO PAGE ════════════ -->
                <StackPanel x:Name="PageMyInfo" Margin="16,12" Visibility="Collapsed">
                    <TextBlock Text="My Information" Foreground="#00E5FF" FontSize="16" FontWeight="Bold" Margin="0,0,0,8" FontFamily="Consolas"/>
                    <TextBlock Text="Your public IP, ISP, geolocation, and timezone details." Foreground="#546E7A" FontSize="11" Margin="0,0,0,12" FontFamily="Consolas"/>

                    <Button Content="Refresh" Style="{StaticResource ActionBtn}" HorizontalAlignment="Left" Margin="0,0,0,12" Click="RefreshMyInfo_Click"/>

                    <StackPanel x:Name="MyInfoResults" />
                </StackPanel>

                <!-- ════════════ NETWORK TOOLS PAGE ════════════ -->
                <StackPanel x:Name="PageTools" Margin="16,12" Visibility="Collapsed">
                    <TextBlock Text="Network Tools" Foreground="#00E5FF" FontSize="16" FontWeight="Bold" Margin="0,0,0,8" FontFamily="Consolas"/>
                    <TextBlock Text="Ping, Traceroute, Port Check, and DNS Lookup." Foreground="#546E7A" FontSize="11" Margin="0,0,0,12" FontFamily="Consolas"/>

                    <StackPanel Orientation="Horizontal" Margin="0,0,0,8">
                        <Button x:Name="ToolPingBtn"  Content="PING"  Style="{StaticResource TabBtnActive}" Width="90" Click="ToolMode_Click"/>
                        <Button x:Name="ToolTraceBtn" Content="TRACE" Style="{StaticResource TabBtn}"        Width="90" Click="ToolMode_Click"/>
                        <Button x:Name="ToolPortBtn"  Content="PORT"  Style="{StaticResource TabBtn}"        Width="90" Click="ToolMode_Click"/>
                        <Button x:Name="ToolDnsBtn"    Content="DNS"   Style="{StaticResource TabBtn}"        Width="90" Click="ToolMode_Click"/>
                    </StackPanel>

                    <StackPanel Orientation="Horizontal" Margin="0,0,0,10">
                        <TextBox x:Name="ToolsHostInput" Style="{StaticResource InputBox}" Width="300" KeyDown="ToolsInput_KeyDown"/>
                        <TextBox x:Name="ToolsPortInput" Style="{StaticResource InputBox}" Width="70" Margin="8,0,0,0" Visibility="Collapsed"/>
                        <Button x:Name="ToolsRunBtn"  Content="RUN"  Style="{StaticResource ActionBtn}" Margin="8,0,0,0" Click="ToolsRun_Click"/>
                        <Button x:Name="ToolsStopBtn" Content="STOP" Style="{StaticResource DangerBtn}"  Margin="8,0,0,0" Visibility="Collapsed" Click="ToolsStop_Click"/>
                    </StackPanel>

                    <Border Background="#0A0E17" BorderBrush="#1E2A3A" BorderThickness="1" CornerRadius="6" Padding="8" Height="380">
                        <ScrollViewer x:Name="ToolsScroll" Style="{StaticResource ScrollViewerStyle}" VerticalScrollBarVisibility="Auto">
                            <TextBlock x:Name="ToolsConsole" FontFamily="Consolas" FontSize="12" Foreground="#E0E8F0" TextWrapping="Wrap"/>
                        </ScrollViewer>
                    </Border>
                </StackPanel>

              </Grid>
            </ScrollViewer>
        </Grid>
    </Grid>
</Window>
