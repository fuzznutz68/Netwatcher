<?xml version="1.0" encoding="utf-8"?>
<selector
  xmlns:android="http://schemas.android.com/apk/res/android">
    <item android:state_selected="true">
        <layer-list>
            <item>
                <shape android:shape="rectangle">
                    <solid android:color="#ff0d1117" />
                </shape>
            </item>
            <item android:gravity="bottom" android:height="2.0dip">
                <shape android:shape="rectangle">
                    <solid android:color="#ff00e5ff" />
                </shape>
            </item>
        </layer-list>
    </item>
    <item>
        <shape android:shape="rectangle">
            <solid android:color="#ff0a0e17" />
        </shape>
    </item>
</selector>