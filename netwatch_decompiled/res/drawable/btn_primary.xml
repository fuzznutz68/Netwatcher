<?xml version="1.0" encoding="utf-8"?>
<selector
  xmlns:android="http://schemas.android.com/apk/res/android">
    <item android:state_pressed="true">
        <shape android:shape="rectangle">
            <solid android:color="#ff003040" />
            <stroke android:width="1.0dip" android:color="#ff00e5ff" />
            <corners android:radius="6.0dip" />
        </shape>
    </item>
    <item>
        <shape android:shape="rectangle">
            <solid android:color="#ff001820" />
            <stroke android:width="1.0dip" android:color="#ff00b8cc" />
            <corners android:radius="6.0dip" />
        </shape>
    </item>
</selector>